# ─────────────────────────────────────────────
# Core-Auth — Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ─────────────────────────────────────────────

# Async Database URL (SQLite for local dev)
DATABASE_URL=sqlite+aiosqlite:///./test.db

# For production PostgreSQL, use:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/coreauth_db

# JWT Access Token Secret (short-lived tokens — 15 min)
SECRET_KEY=your-access-token-secret-min-32-chars-change-this

# JWT Refresh Token Secret (long-lived tokens — 7 days)
# MUST be different from SECRET_KEY
REFRESH_SECRET_KEY=your-refresh-token-secret-min-32-chars-change-this

# Algorithm for JWT signing
ALGORITHM=HS256

# Token expiry settings
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis URL (for token blacklisting)
REDIS_URL=redis://localhost:6379
